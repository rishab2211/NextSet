# NextSet PWA Client Environment Configuration

# Production API Endpoint (Default Cloudflare Workers URL)
# Replace <account-subdomain> with your Cloudflare workers.dev subdomain (shown after `wrangler deploy`)
NEXT_PUBLIC_API_URL=https://nextset-api-production.<account-subdomain>.workers.dev

# Production Web App URL (Default Cloudflare Pages URL)
NEXT_PUBLIC_APP_URL=https://nextset.pages.dev
