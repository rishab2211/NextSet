{
  "name": "@nextset/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "d1:init": "wrangler d1 execute nextset-db --local --file=./schema.sql",
    "d1:init:prod": "wrangler d1 execute nextset-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "@nextset/shared": "*",
    "hono": "^4.3.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240512.0",
    "typescript": "^5.4.5",
    "wrangler": "^3.57.1"
  }
}
