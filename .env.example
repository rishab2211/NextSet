# NextSet Monorepo Environment Configuration Reference

# -------------------------------------------------------------
# Web Client (apps/web/.env.local)
# -------------------------------------------------------------
# Production API URL (Cloudflare Worker)
NEXT_PUBLIC_API_URL=https://nextset-api-production.rishabraj2211.workers.dev

# Production Web App URL (Cloudflare Pages)
NEXT_PUBLIC_APP_URL=https://nextset-4u3.pages.dev

# -------------------------------------------------------------
# API Worker (apps/api/.dev.vars)
# -------------------------------------------------------------
# Runtime environment ('development' | 'staging' | 'production')
ENVIRONMENT=development

# 64-character secret for HMAC-SHA256 JWT tokens (required for local auth token signing)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
